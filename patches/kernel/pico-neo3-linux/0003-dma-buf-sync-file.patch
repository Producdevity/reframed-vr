+// SPDX-License-Identifier: GPL-2.0-only
+/* The signaled stub follows Linux dma-fence.c (Canonical/Texas Instruments). */
+#include <linux/dma-fence.h>
+#include <linux/dma-fence-array.h>
+#include <linux/dma-fence-merge.h>
+#include <linux/export.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+
+static DEFINE_SPINLOCK(stub_lock);
+static struct dma_fence stub;
+
+static const char *stub_name(struct dma_fence *fence)
+{
+    return "stub";
+}
+
+static const struct dma_fence_ops stub_ops = {
+    .get_driver_name = stub_name,
+    .get_timeline_name = stub_name,
+};
+
+static struct dma_fence *signaled_stub(void)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&stub_lock, flags);
+    if (!stub.ops) {
+        dma_fence_init(&stub, &stub_ops, &stub_lock, 0, 0);
+        set_bit(DMA_FENCE_FLAG_ENABLE_SIGNAL_BIT, &stub.flags);
+        dma_fence_signal_locked(&stub);
+    }
+    dma_fence_get(&stub);
+    spin_unlock_irqrestore(&stub_lock, flags);
+    return &stub;
+}
+
+static int compare_context(const void *left, const void *right)
+{
+    const struct dma_fence *a = *(struct dma_fence * const *)left;
+    const struct dma_fence *b = *(struct dma_fence * const *)right;
+
+    return (a->context > b->context) - (a->context < b->context);
+}
+
+struct dma_fence *dma_fence_merge_all(unsigned int count,
+                                     struct dma_fence **fences)
+{
+    struct dma_fence **pending, **grown, *fence;
+    struct dma_fence_array *array;
+    unsigned int i, j, used = 0, total = count;
+
+    pending = kmalloc_array(count, sizeof(*pending), GFP_KERNEL);
+    if (!pending && count)
+        return NULL;
+    for (i = 0; i < count; ++i)
+        pending[i] = dma_fence_get(fences[i]);
+
+    /* Flatten AND containers iteratively; OR containers remain dependencies. */
+    for (i = 0; i < total; ++i) {
+        fence = pending[i];
+        if (!fence || dma_fence_is_signaled(fence)) {
+            dma_fence_put(fence);
+            pending[i] = NULL;
+            continue;
+        }
+        array = to_dma_fence_array(fence);
+        if (!array || array->signal_on_any)
+            continue;
+        if (array->num_fences > INT_MAX - total)
+            goto fail;
+        grown = krealloc(pending, (total + array->num_fences) * sizeof(*pending),
+                         GFP_KERNEL);
+        if (!grown)
+            goto fail;
+        pending = grown;
+        for (j = 0; j < array->num_fences; ++j)
+            pending[total++] = dma_fence_get(array->fences[j]);
+        pending[i] = NULL;
+        dma_fence_put(fence);
+    }
+    for (i = 0; i < total; ++i)
+        if (pending[i])
+            pending[used++] = pending[i];
+    sort(pending, used, sizeof(*pending), compare_context, NULL);
+
+    count = 0;
+    for (i = 0; i < used; ++i) {
+        fence = pending[i];
+        if (count && pending[count - 1]->context == fence->context) {
+            if (dma_fence_is_later(fence, pending[count - 1])) {
+                dma_fence_put(pending[count - 1]);
+                pending[count - 1] = fence;
+            } else {
+                dma_fence_put(fence);
+            }
+        } else {
+            pending[count++] = fence;
+        }
+    }
+    if (count < 2) {
+        fence = count ? pending[0] : signaled_stub();
+        kfree(pending);
+        return fence;
+    }
+    array = dma_fence_array_create(count, pending, dma_fence_context_alloc(1),
+                                  1, false);
+    if (array)
+        return &array->base;
+    total = count;
+fail:
+    for (i = 0; i < total; ++i)
+        dma_fence_put(pending[i]);
+    kfree(pending);
+    return NULL;
+}
+EXPORT_SYMBOL_GPL(dma_fence_merge_all);
