+	if (copy_from_user(&arg, user_data, sizeof(arg)))
+		return -EFAULT;
+
+	if (arg.flags & ~DMA_BUF_SYNC_RW)
+		return -EINVAL;
+
+	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+
+	fence = sync_file_get_fence(arg.fd);
+	if (!fence)
+		return -EINVAL;
+
+	ret = ww_mutex_lock(&dmabuf->resv->lock, NULL);
+	if (ret)
+		goto out_put;
+
+	if (arg.flags & DMA_BUF_SYNC_WRITE) {
+		ret = reservation_object_add_excl_fence_preserve(dmabuf->resv, fence);
+	} else {
+		ret = reservation_object_reserve_shared(dmabuf->resv);
+		if (!ret)
+			reservation_object_add_shared_fence(dmabuf->resv, fence);
+	}
+
+	ww_mutex_unlock(&dmabuf->resv->lock);
+out_put:
+
+	dma_fence_put(fence);
+
+	return ret;
+}
