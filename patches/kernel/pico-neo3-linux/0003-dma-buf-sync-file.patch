+int reservation_object_add_excl_fence_preserve(struct reservation_object *obj,
+                                               struct dma_fence *fence)
+{
+    struct dma_fence *old, *merged, *heads[2];
+
+    reservation_object_assert_held(obj);
+    old = reservation_object_get_excl(obj);
+    heads[0] = old;
+    heads[1] = fence;
+    merged = dma_fence_merge_all(2, heads);
+    if (!merged)
+        return -ENOMEM;
+
+    /* Imported writers do not imply completion of preceding readers/writers. */
+    preempt_disable();
+    write_seqcount_begin(&obj->seq);
+    RCU_INIT_POINTER(obj->fence_excl, merged);
+    write_seqcount_end(&obj->seq);
+    preempt_enable();
+    dma_fence_put(old);
+    return 0;
+}
+EXPORT_SYMBOL_GPL(reservation_object_add_excl_fence_preserve);
+
