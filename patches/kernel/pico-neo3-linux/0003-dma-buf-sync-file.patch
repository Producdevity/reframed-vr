+static int dma_buf_get_sync_fence(struct dma_buf *dmabuf, bool write,
+                                  struct dma_fence **result)
+{
+    struct dma_fence **fences;
+    unsigned int count, i;
+    int ret;
+
+    if (!write) {
+        *result = reservation_object_get_excl_rcu(dmabuf->resv);
+        return 0;
+    }
+    ret = reservation_object_get_fences_rcu(dmabuf->resv, NULL, &count, &fences);
+    if (ret)
+        return ret;
+    *result = dma_fence_merge_all(count, fences);
+    for (i = 0; i < count; ++i)
+        dma_fence_put(fences[i]);
+    kfree(fences);
+    return *result ? 0 : -ENOMEM;
