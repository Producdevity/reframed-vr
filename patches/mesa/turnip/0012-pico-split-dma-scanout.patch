@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef WSI_DISPLAY_PICO_H
+#define WSI_DISPLAY_PICO_H
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+enum wsi_pico_property {
+   PICO_FB, PICO_CRTC, PICO_X, PICO_Y, PICO_W, PICO_H,
+   PICO_SRC_X, PICO_SRC_Y, PICO_SRC_W, PICO_SRC_H,
+   PICO_ROTATION, PICO_ZPOS, PICO_ALPHA, PICO_BLEND,
+   PICO_EXCLUSION, PICO_LAYOUT, PICO_PROPERTY_COUNT
+};
+
+struct wsi_pico_plane {
+   uint32_t id;
+   uint32_t property[PICO_PROPERTY_COUNT];
+};
+
+struct wsi_pico_split {
+   bool enabled;
+   struct wsi_pico_plane plane[2];
+};
+
+static bool
+wsi_pico_plane_properties(int fd, struct wsi_pico_plane *plane)
+{
+   memset(plane->property, 0, sizeof(plane->property));
+   static const char *names[PICO_PROPERTY_COUNT] = {
+      "FB_ID", "CRTC_ID", "CRTC_X", "CRTC_Y", "CRTC_W", "CRTC_H",
+      "SRC_X", "SRC_Y", "SRC_W", "SRC_H", "rotation", "zpos", "alpha",
+      "blend_op", "excl_rect_v1", "sspp_layout"
+   };
+   drmModeObjectProperties *props =
+      drmModeObjectGetProperties(fd, plane->id, DRM_MODE_OBJECT_PLANE);
+   if (!props)
+      return false;
+   bool dma = false, scaler = false, overlay = false, valid = true;
+   for (uint32_t i = 0; i < props->count_props; i++) {
+      drmModePropertyPtr prop = drmModeGetProperty(fd, props->props[i]);
+      if (!prop) {
+         valid = false;
+         break;
+      }
+      if (!strcmp(prop->name, "type"))
+         overlay = props->prop_values[i] == DRM_PLANE_TYPE_OVERLAY;
+      if (!strcmp(prop->name, "csc_dma_v1"))
+         dma = true;
+      if (!strcmp(prop->name, "scaler_v2"))
+         scaler = true;
+      for (unsigned p = 0; p < PICO_PROPERTY_COUNT; p++) {
+         if (!strcmp(prop->name, names[p]) && !(prop->flags & DRM_MODE_PROP_IMMUTABLE))
+            plane->property[p] = props->props[i];
+      }
+      drmModeFreeProperty(prop);
+   }
+   drmModeFreeObjectProperties(props);
+   for (unsigned p = 0; p < PICO_PROPERTY_COUNT; p++)
+      valid &= plane->property[p] != 0;
+   return valid && overlay && dma && !scaler;
+}
+
+static bool
+wsi_pico_split_init(int fd, uint32_t crtc, unsigned crtc_index,
+                    struct wsi_pico_split *split)
+{
+   memset(split, 0, sizeof(*split));
+   if (crtc_index >= 32)
+      return false;
+   drmVersionPtr version = drmGetVersion(fd);
+   if (!version)
+      return false;
+   bool msm = version->name && version->name_len == 7 &&
+              !memcmp(version->name, "msm_drm", 7);
+   drmFreeVersion(version);
+   if (!msm)
+      return false;
+   drmModePlaneRes *planes = drmModeGetPlaneResources(fd);
+   if (!planes)
+      return false;
+   bool valid = planes->count_planes >= 8 && planes->count_planes <= 64;
+   /* Neo3's vendor SDE inventory creates physical DMA2/3 at slots 6/7. */
+   for (unsigned i = 0; valid && i < 2; i++) {
+      struct wsi_pico_plane *pico = &split->plane[i];
+      pico->id = planes->planes[6 + i];
+      drmModePlane *plane = drmModeGetPlane(fd, pico->id);
+      if (!plane) {
+         valid = false;
+         break;
+      }
+      valid = (plane->possible_crtcs & (1u << crtc_index)) &&
+              (!plane->crtc_id || plane->crtc_id == crtc) &&
+              plane->count_formats > 0 && plane->count_formats <= 256;
+      drmModeFreePlane(plane);
+      if (valid)
+         valid = wsi_pico_plane_properties(fd, pico);
+   }
+   drmModeFreePlaneResources(planes);
+   if (!valid || !split->plane[0].id || split->plane[0].id == split->plane[1].id) {
+      memset(split, 0, sizeof(*split));
+      return false;
+   }
+   split->enabled = true;
+   return true;
+}
+
+static uint32_t
+wsi_pico_split_filter_formats(int fd, const struct wsi_pico_split *split,
+                              uint32_t count, uint32_t *formats)
+{
+   drmModePlane *planes[2] = {
+      drmModeGetPlane(fd, split->plane[0].id),
+      drmModeGetPlane(fd, split->plane[1].id)
+   };
+   uint32_t kept = 0;
+   if (!planes[0] || !planes[1])
+      goto out;
+   for (uint32_t f = 0; f < count; f++) {
+      bool both = true;
+      for (unsigned p = 0; p < 2; p++) {
+         bool found = false;
+         for (uint32_t n = 0; n < planes[p]->count_formats; n++)
+            found |= planes[p]->formats[n] == formats[f];
+         both &= found;
+      }
+      if (both)
+         formats[kept++] = formats[f];
+   }
+out:
+   if (planes[0]) drmModeFreePlane(planes[0]);
+   if (planes[1]) drmModeFreePlane(planes[1]);
+   return kept;
+}
+
+static int
+wsi_pico_split_add(drmModeAtomicReq *req, const struct wsi_pico_split *split,
+                   uint32_t crtc, uint32_t fb, uint32_t width, uint32_t height,
+                   bool enable)
+{
+   if (!split->enabled || width != 1920 || height != 3664 ||
+       (enable && (!crtc || !fb)))
+      return -EINVAL;
+   for (unsigned i = 0; i < 2; i++) {
+      const struct wsi_pico_plane *plane = &split->plane[i];
+      uint64_t x = i ? 0 : 960;
+      uint64_t value[PICO_PROPERTY_COUNT] = {
+         fb, crtc, x, 0, 960, 3664, x << 16, 0, 960u << 16, 3664u << 16,
+         1, 0, 255, 2, 0, 0
+      };
+      if (!enable) value[PICO_FB] = value[PICO_CRTC] = 0;
+      unsigned count = enable ? PICO_PROPERTY_COUNT : 2;
+      for (unsigned p = 0; p < count; p++) {
+         if (!plane->id || !plane->property[p])
+            return -EINVAL;
+         int ret = drmModeAtomicAddProperty(req, plane->id, plane->property[p], value[p]);
+         if (ret < 0)
+            return ret;
+      }
+   }
+   return 0;
+}
+
+#endif
