#!/bin/sh
set -eu
[ "$#" -eq 3 ] || exit 64
serial=$(cat "$3")
boot=$(cat /proc/sys/kernel/random/boot_id)
exec /usr/bin/python3 "@CMAKE_INSTALL_PREFIX@/libexec/reframed-vr/pico-wifi-identity.py" \
    --boot-serial "$serial" --boot-id "$boot" \
    --identity /etc/reframed-vr/pico-radio-identities.json --interface "$1" --output "$2"
